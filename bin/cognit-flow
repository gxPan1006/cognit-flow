#!/usr/bin/env node
// Loads the compiled CLI from ../dist/cli.js (run `npm run build` first).
import("../dist/cli.js")
  .then(({ main }) => main())
  .catch((err) => {
    if (err && err.code === "ERR_MODULE_NOT_FOUND") {
      console.error(
        "Compiled output missing. Run `npm run build` first, or use `npm run start -- <args>` for dev.",
      );
      process.exit(1);
    }
    console.error(err instanceof Error ? err.stack ?? err.message : String(err));
    process.exit(1);
  });
